# LLM provider for exercise generation. Any OpenAI-compatible chat API works.
# Without a key the app runs entirely offline (built-in generator).
#
# Default provider is OpenRouter with a free GLM model.
#   1. Get a key at https://openrouter.ai/keys
#   2. Set it below.
API_KEY=

# Optional — override the provider / model.
# Examples:
#   OpenRouter (default base):  https://openrouter.ai/api/v1
#   Groq:                       https://api.groq.com/openai/v1
#   DeepSeek:                    https://api.deepseek.com
#   Gemini (OpenAI-compat):     https://generativelanguage.googleapis.com/v1beta/openai
# LLM_BASE_URL=
#
# Model ids (Gemini retires flash models fast — if you get a 404, the error
# body names the current one):
#   Gemini:          gemini-3.6-flash
#   OpenRouter free: z-ai/glm-5.2:free, minimax/minimax-m3:free, google/gemma-4-31b-it:free
# LLM_MODEL=gemini-3.6-flash
